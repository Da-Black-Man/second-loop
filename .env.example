# Optional: enables the eBay source. Facebook Marketplace works without credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Optional runtime controls.
PORT=5173
SECONDHAND_MCP_PACKAGE=secondhand-mcp@0.5.0
SECONDHAND_MCP_TIMEOUT_MS=30000
# Set true to always use the included sample catalog.
DEMO_MODE=false
